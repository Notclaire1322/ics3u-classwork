#games_remaining is set to total_season_games - games_played, which is 162-88= 74. game_remaining is 74 now.
games_remaining = total_season_games - games_played
#home_runs_per_game is set to 31/88 which is around 0.35 home runs per game
home_runs_per_game = home_runs_to_date / games_played
#projected_home_runs is set to 0.35 times 162 which is around 57.
projected_home_runs = home_runs_per_game * total_season_games
#this sets can_break_record to either false or true, because home_run_record is greater than the other it is set to false.
can_break_record = projected_home_runs > home_run_record


#Prints Vladimir Guerrero Jr.'s name then prints "of the" then prints Toronto Blue Jays
