Where is it?
import random
numbers=[]
count=0
found=False
for i in range(10):
   num=random.randint(1,50)
   numbers.append(num)
print(numbers)
find=int(input("Find Value:"))
for number in numbers:
   if number==find:
       print(number, "is at index", count)
       found=True
   count+=1
if found==False:
   print("Not found")

