Finding a Value in a List
import random
list=[]
for i in range(10):
   list.append(random.randint(1,50))
print(list)
value=int(input("Input value"))
for n in list:
   if n==value:
       print(value,"is in the list")





How many times?
import random
list=[]
count=0
for i in range(10):
   randomstuff=random.randrange(1,50)
   list.append(randomstuff)
print(list)
find=int(input("Value to find:"))
for i in list:
   if i==find:
       count+=1
print(find, "was found", count, "time(s)")



