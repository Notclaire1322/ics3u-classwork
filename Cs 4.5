Shorter Double Dice
import random
same="no"
while True:
   dice1=random.randrange(1,6)
   dice2=random.randrange(1,6)
   if dice1==dice2:
       same="yes"


   print("dice1", dice1)
   print("dice2", dice2)
   print("total", dice1+dice2)
   if same=="yes":
           print("same dices!")
           break


Again with the Number Guessing

import random
number=random.randrange(1,10)
counter=1
guess=int(input("your guess"))
while True:
   if guess==number:
       print("goodjob")
       print("counter",counter)
       break
   else:
       print("wrong")
       guess=int(input("your guess"))
       counter+=1

Safe Square Root

import math
number=int(input("Number to be square rooted"))
while True:


   if number<0:
       print("Number cannot be negative")
       number=int(input("Number to be square rooted"))
       continue
   else:
       print(math.sqrt(number))
       number = int(input("Number to be square rooted"))

