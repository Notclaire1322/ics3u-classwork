6.
theInput="x:2,y:5-x:5,y:11"
Chords=theInput.split("-")
list=[]
for part in Chords:
   xPart,yPart=part.split(",")
   x = int(xPart.split(":")[1].strip())
   y = int(yPart.split(":")[1].strip())
   list.append([x,y])
print(list)




