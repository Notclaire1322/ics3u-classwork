3.
string=input("Enter some numbers in word form")
list=[]
stringsplit=string.split(' ')
for n in stringsplit:
   newN=n.lower()
   if newN=="zero":
       list.append(0)
   elif newN=="one":
       list.append(1)
   elif newN=="two":
       list.append(2)
   elif newN=="three":
       list.append(3)
   elif newN=="four":
       list.append(4)
   elif newN=="five":
       list.append(5)
   else:
       list.append(newN)


print(list)

4.
winsLosses=input("WLF enter it in")
pointString=winsLosses.split(" ")
Pointlist=[]
for games in pointString:
   upperConvert=games.upper()
   if upperConvert=="W":
       Pointlist.append(2)
   if upperConvert=="T":
       Pointlist.append(1)
   if upperConvert=="L":
       Pointlist.append(0)
print(Pointlist)

