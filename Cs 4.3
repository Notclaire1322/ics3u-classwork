Pin lockout

PIN = "12345"
tries = 0
totalTries=4
print("WELCOME TO THE BANK OF GALLO.")
entry = input("ENTER YOUR PIN: ")
tries += 1


while entry != PIN and tries < totalTries:
   print("\nINCORRECT PIN. TRY AGAIN.")
   entry = input("ENTER YOUR PIN: ")
   tries += 1


if entry == PIN:
   print("\nPIN ACCEPTED. YOU NOW HAVE ACCESS TO YOUR ACCOUNT.")
elif tries >= totalTries:
   print("\nYOU HAVE RUN OUT OF TRIES. ACCOUNT LOCKED.")

Number Guessing with a counter
print("I choose number between 1 and 10")
import random
number=random.randint(1,10)
attempts=1
guess=int(input("Guess number"))


while guess!=number:
   attempts+=1
   print("wrong")
   guess=int(input("Guess number"))
else:
   print("Good job")
   print("it took you "+str(attempts)+" attempts")

Hi Lo with Limited Tries
print("I choose number between 1 and 100")
import random
number=random.randint(1,100)
print(number)
guess=int(input("Guess a number between 1 and 100"))
attempts=1
while number != guess:
   while attempts<7:
       if guess<number:
           print("Too low")
           guess=int(input("Wrong. Guess a number between 1 and 100"))
           attempts+=1
       if guess>number:
           print("Too high")
           guess=int(input("Wrong. Guess a number between 1 and 100"))
           attempts+=1
   else:
       if number!=guess:
           print("no more attempts")
           break
       else: print("You got it on the last try!")
else:
   print("correct")
   print(attempts, "attempts")

