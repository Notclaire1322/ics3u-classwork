Flicker Phrase
import random
import time




def main():
   for i in range(100000):
       time.sleep(0.3)
       r = random.randrange(1, 6)
       # Write five if statements here.
       if r==1:
           first()
       elif r==2:
           second()
       elif r==3:
           third()
       elif r==4:
           fourth()
       elif r==5:
           fifth()
       elif r==6:
           sixth()


      
         # clear console


   print("I pledge allegiance to the flag.");




def first():
   print("I                               ");




def second():
   print("  pledge                        ");




def third():
   print("         allegiance             ");




def fourth():
   print("                    to the      ");




def fifth():
   print("                           flag.");




if __name__ == "__main__":
   main()

